rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registro: un nombre solo se puede registrar una vez
    match /members/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    // Feedback privado (cifrado): se crea y no se modifica
    match /feedback/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    // Notas públicas: solo se pueden cambiar los votos
    match /notes/{id} {
      allow read, create, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
    }
    match /threads/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /given/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /stats/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
