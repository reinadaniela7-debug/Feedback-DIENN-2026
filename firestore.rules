rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /members/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /feedback/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /notes/{id} {
      allow read, create, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
    }
    match /threads/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /given/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /stats/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /prueba_members/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /prueba_feedback/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /prueba_notes/{id} {
      allow read, create, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
    }
    match /prueba_threads/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /prueba_given/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /prueba_stats/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /temas/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['ek','iv','ct','at'])
        && request.resource.data.ek is string && request.resource.data.ek.size() < 1000
        && request.resource.data.iv is string && request.resource.data.iv.size() < 40
        && request.resource.data.ct is string && request.resource.data.ct.size() < 2000
        && request.resource.data.at is int;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
