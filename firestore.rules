rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /members/{id} {
      allow read, create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salt','iv','wrapped','rsalt','riv','rwrapped']);
      allow delete: if true;
    }
    match /feedback/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /notes/{id} {
      allow read, create, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
    }
    match /threads/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /given/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /stats/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /prueba_members/{id} {
      allow read, create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salt','iv','wrapped','rsalt','riv','rwrapped']);
      allow delete: if true;
    }
    match /prueba_feedback/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /prueba_notes/{id} {
      allow read, create, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
    }
    match /prueba_threads/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /prueba_given/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /prueba_stats/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /temas/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['text','at','votes'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 300
        && request.resource.data.at is int
        && request.resource.data.votes == [];
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.votes is list
        && request.resource.data.votes.size() <= 300;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
